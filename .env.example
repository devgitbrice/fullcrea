# Supabase — copie ce fichier en .env.local et remplis avec tes valeurs
# (Dashboard Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — utilisé côté serveur uniquement (génération image / vidéo / voix)
# AI Studio → API key
GEMINI_API_KEY=

# OpenAI — voix off « Text to Speech » de la piste Voix Off (côté serveur)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optionnel : modèle TTS (défaut gpt-4o-mini-tts)
OPENAI_TTS_MODEL=
